# Settings read by qualityintel.config. All are optional: the defaults below are used when a
# variable is missing or empty. Set them in your shell (cmd: `set QI_DATABASE=...`,
# bash: `export QI_DATABASE=...`); `qi config` prints the values in effect.
# Never put a real password in this file (it is committed).

# SQLite file for the execution history (created on first use)
QI_DATABASE=.qi/quality.db

# Address the dashboard listens on (127.0.0.1 = this machine only)
QI_DASHBOARD_HOST=127.0.0.1
QI_DASHBOARD_PORT=8000

# How often the dashboard looks for new data in its sources (seconds; 0 = never)
QI_REFRESH_SECONDS=30

# Collection page: hours after which a repository's last collection is overdue, and a link
# to the collection workflow
# QI_COLLECTION_HOURS=26
# QI_COLLECTION_URL=https://github.com/OWNER/REPO/actions/workflows/collect.yml

# Login for the dashboard (HTTP basic authentication, at least 12 characters). Required for
# any address other than this machine; set it in the environment, never here.
# QI_DASHBOARD_USER=qi
# QI_DASHBOARD_PASSWORD=

# Serve without a login on any address, on purpose (a public demonstration of public data only)
# QI_DASHBOARD_PUBLIC=false

# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are believed (comma-separated, or *
# when only the platform's proxy can reach the port); default 127.0.0.1
# QI_FORWARDED_ALLOW_IPS=
